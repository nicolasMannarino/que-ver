# Copiá este archivo a .env y completá los valores.
# .env está en .gitignore: nunca se sube al repo. No lo pegues en un chat, ni
# en un issue, ni te lo mandes por mail: las dos primeras variables juntas son
# acceso completo a la base y a las API keys de todos.

# --- Para ver EN TU COMPU lo mismo que está en la web ------------------------
# Con estas dos, la app de acá deja de usar los archivos de data/ y trabaja
# contra la misma base que la publicada: lo que puntuás en el celular aparece
# acá, y al revés. Sin ellas sigue andando sola, con sus archivos.
#
# Las dos tienen que ser EXACTAMENTE las mismas que tiene Render, o no sirve:
#   Render -> tu servicio -> Environment
#
# DATABASE_URL: la connection string de Neon, la que dice "pooled".
DATABASE_URL=

# SESSION_SECRET: el mismo de Render, sin cambiarle una letra. Firma las
# sesiones y descifra las API keys guardadas. Si acá ponés otro, la app
# arranca igual pero no puede leer tu key de TMDB y te la va a pedir de nuevo.
SESSION_SECRET=

# --- Lo de siempre -----------------------------------------------------------

# API key de TMDB, sólo para el modo sin base (archivos en data/). Con cuenta,
# cada uno trae la suya y esto no se usa.
# Se saca gratis en https://www.themoviedb.org/settings/api
# Sirve tanto la key v3 (32 caracteres) como el token v4 (empieza con "ey").
TMDB_API_KEY=

# Puerto del servidor. Por defecto 5173.
PORT=5173

# Dónde escucha. Por defecto 127.0.0.1: sólo esta compu, nadie más de la red.
# Ponerlo en 0.0.0.0 lo abre a todo el WiFi — y en tu compu la app NO pide
# contraseña, así que sólo hacelo en una red en la que confíes.
# HOST=0.0.0.0
